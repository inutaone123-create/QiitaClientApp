{
  "permissions": {
    "allow": [
      "Bash(git remote *)",
      "Bash(python3 -m pip install -q -r requirements.txt)",
      "Bash(python3 -c \"import fastapi, uvicorn, sqlalchemy, httpx, respx, dotenv, pydantic, pytest; print\\('OK: 全依存パッケージ import 成功'\\)\")",
      "Bash(pkill -f \"uvicorn src.main:app\")",
      "Bash(python3 -m pytest -q)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" --max-time 5 https://qiita.com/api/v2/authenticated_user)",
      "Bash(curl -s -w \"\\\\nHTTP_STATUS:%{http_code}\\\\n\" -H \"Cookie: QIITA_TOKEN_OVERRIDE=\" http://localhost:8000/api/auth/verify)",
      "Bash(QIITA_TOKEN=invalid-dummy-token python3 -c ' *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git merge *)",
      "Bash(git branch *)",
      "Bash(git push *)",
      "Bash(curl -sL -o static/vendor/marked.min.js https://cdn.jsdelivr.net/npm/marked@13.0.3/marked.min.js)",
      "Bash(curl -s http://localhost:8000/api/drafts)",
      "Bash(python3 -m json.tool)",
      "Bash(curl -s -X DELETE -o /dev/null -w \"delete: %{http_code}\\\\n\" http://localhost:8000/api/drafts/1)",
      "Bash(command -v chromium-cli)",
      "Bash(npm -v)",
      "Bash(python3 -c \"import playwright\")",
      "Bash(node -e \"require\\('playwright'\\)\")",
      "Read(//tmp/**)",
      "Bash(timeout 90 npm install playwright --no-save --silent)",
      "Bash(ls /tmp/node_modules/.bin/ 2>&1 | grep -i playwright; ls /tmp/node_modules 2>&1 | grep -i playwright)",
      "Read(//tmp/node_modules/.bin/**)",
      "Read(//tmp/node_modules/**)",
      "Bash(timeout 120 node_modules/.bin/playwright install chromium)",
      "Bash(curl -s -o /dev/null -w \"server: %{http_code}\\\\n\" http://localhost:8000/)",
      "Bash(node /tmp/claude-0/-workspace/20ce2b77-bafd-4b9c-86b6-12f579671346/scratchpad/drive.js)",
      "Bash(timeout 120 node_modules/.bin/playwright install-deps chromium)",
      "Bash(python3 -m pip install -q black)",
      "Bash(python3 -m black --check .)",
      "Bash(python3 -m black --line-length 100 .)",
      "Bash(python3 -m black .)",
      "Bash(python3 -)",
      "Bash(curl -sL -o static/vendor/purify.min.js https://cdn.jsdelivr.net/npm/dompurify@3.1.6/dist/purify.min.js)",
      "Bash(node /tmp/claude-0/-workspace/20ce2b77-bafd-4b9c-86b6-12f579671346/scratchpad/xss_check.js)",
      "Bash(sphinx-build --version)",
      "Bash(sphinx-quickstart docs/sphinx --quiet --project=QiitaClientApp --author=Inuta --language=ja --ext-autodoc --ext-viewcode --ext-napoleon)",
      "Bash(sphinx-quickstart --help)",
      "Bash(sphinx-quickstart docs/sphinx --quiet --project=QiitaClientApp --author=Inuta --language=ja --ext-autodoc --ext-viewcode)",
      "Bash(sphinx-apidoc -o docs/sphinx . --force --separate --module-first --implicit-namespaces -e)",
      "Bash(rm -f docs/sphinx/workspace*.rst docs/sphinx/modules.rst && ls docs/sphinx/*.rst)",
      "Bash(sphinx-apidoc -o docs/sphinx src --force --separate --module-first -e)",
      "Bash(sphinx-build -b html docs/sphinx docs/sphinx/_build/html -q)",
      "Bash(python3 -c ' *)",
      "Bash(python3 -c \"import sqlalchemy; print\\(sqlalchemy.__file__, sqlalchemy.__version__\\)\")",
      "Bash(pip show *)",
      "Bash(sphinx-build -b html docs/sphinx docs/sphinx/_build/html)"
    ],
    "additionalDirectories": [
      "/workspace/docs/sphinx",
      "/tmp"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] [PRE] サブエージェント召喚の儀、執り行われ候\" >> /workspace/.claude/agent.log"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] [POST] サブエージェント帰還の儀、相成り候\" >> /workspace/.claude/agent.log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] [STOP] Claude Code、本日の御役目を果たし申した\" >> /workspace/.claude/agent.log"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%H:%M:%S')] [NOTIFY] $(echo $CLAUDE_NOTIFICATION | head -c 100)\" >> /workspace/.claude/agent.log"
          }
        ]
      }
    ]
  }
}
